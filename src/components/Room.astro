---
// The whole site: the room, with one door open when the page is an aspect's (/listen, /i, ...).
import profile from "../assets/profile.jpeg";
import { getRoomData } from "../lib/room";
import { renderRoom } from "../room/render/room";
import "../room/room.css";
import "../room/room-extra.css";

interface Props {
	open?: string;
}
const { open } = Astro.props;
const data = await getRoomData();
const name = open === "me" ? "i" : open;
const title = name ? `${name} · onesal.me` : "onesal.me";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="sal's room: what i listen to, watch, read, play, make, and the shows i went to." />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Fragment set:html={renderRoom(data, profile.src, open)} />

		<!--
			doors grow with the screen until the row overflows with the end door half in view, so the strip always reads as
			scrollable. when the real doors already overflow at the smallest width, they stay at the smallest width.
			(a phone ignores --door: its shelves hold desktop-sized doors at 80%)
			this runs inline, before the first paint: the module script comes after it, and setting --door then would
			show every door easing out from 190px on load.
		-->
		<script is:inline>
			(() => {
				const el = document.getElementById("strip");
				if (!el) return;
				const n = el.querySelectorAll(".box:not(.end-box)").length;
				const size = () => {
					const min = 190;
					const gap = 10;
					const w = el.clientWidth;
					const door = n * min + (n - 1) * gap > w ? min : Math.max(min, (w - n * gap) / (n + 0.5));
					el.style.setProperty("--door", `${door}px`);
				};
				size();
				addEventListener("resize", size);
			})();
		</script>

		<script>
			import "../room/client/main";
		</script>
	</body>
</html>
